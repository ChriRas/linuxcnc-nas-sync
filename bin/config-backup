#!/bin/bash
# Back up BACKUP_SOURCE as a snapshot to BACKUP_TARGET on the NAS.
# A new snapshot is created only if something changed since the last one.
# Unchanged files are hard-linked to the previous snapshot (--link-dest).
# A snapshot counts as complete only once its marker file <snapshot>.complete exists.
# Snapshot names are UTC timestamps.
# Retention: snapshots older than BACKUP_KEEP_DAYS are deleted, the newest
# BACKUP_KEEP_MIN are always kept.
#
# Options: -f  skip the LinuxCNC state check (tests only)
set -euo pipefail
# shellcheck source=../lib/common.sh
. "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

FORCE=0
# shellcheck disable=SC2034  # FORCE is read by wait_idle_or_exit in lib/common.sh
while getopts f opt; do
    case $opt in
        f) FORCE=1 ;;
        *) exit 2 ;;
    esac
done

load_conf
: "${BACKUP_TARGET:?BACKUP_TARGET missing in $CONF}"
BACKUP_SOURCE=${BACKUP_SOURCE:-$HOME/linuxcnc/configs}
BACKUP_KEEP_DAYS=${BACKUP_KEEP_DAYS:-14}
BACKUP_KEEP_MIN=${BACKUP_KEEP_MIN:-10}
TARGET=${BACKUP_TARGET%/}
[[ $BACKUP_KEEP_DAYS =~ ^[0-9]+$ ]] || die "BACKUP_KEEP_DAYS must be a whole number"
[[ $BACKUP_KEEP_MIN =~ ^[0-9]+$ ]] && [ "$BACKUP_KEEP_MIN" -ge 1 ] ||
    die "BACKUP_KEEP_MIN must be a whole number of at least 1"

take_lock config-backup || exit 0
wait_idle_or_exit

check_route
[ -d "$BACKUP_SOURCE" ] || die "source missing: $BACKUP_SOURCE"

# Do not back up metadata, temp, runtime and cache files
FILTER=("${COMMON_EXCLUDES[@]}" --exclude='__pycache__/' --exclude='*.pyc'
        --exclude='*.pickle*' --exclude='*-shm' --exclude='*.log')
OPTS=(-rlptD --delete --chmod=u+rw)

EMPTY=$(mktemp -d)
trap 'rm -rf "$EMPTY"' EXIT

# Create BACKUP_TARGET if it does not exist yet (only the last path component)
rsync_low -d --chmod=D755 "$EMPTY/" "$(remote_path "$TARGET/")"

# List snapshots (directories) and markers on the NAS
listing=$(rsync_low --list-only "$(remote_path "$TARGET/")")
STAMP='[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{6}'
mapfile -t dirs < <(awk -v re="^$STAMP\$" '$1 ~ /^d/ && $NF ~ re {print $NF}' <<<"$listing" | sort)
mapfile -t done_ < <(awk -v re="^$STAMP\\.complete\$" '$1 ~ /^-/ && $NF ~ re {sub(/\.complete$/, "", $NF); print $NF}' <<<"$listing" | sort)
complete=()
for d in "${dirs[@]}"; do
    printf '%s\n' "${done_[@]}" | grep -qx "$d" && complete+=("$d")
done
latest=
[ "${#complete[@]}" = 0 ] || latest=${complete[-1]}

changed=1
if [ -n "$latest" ]; then
    diff=$(rsync_low -n "${OPTS[@]}" "${FILTER[@]}" --out-format='%i %n' \
        "${BACKUP_SOURCE%/}/" "$(remote_path "$TARGET/$latest/")")
    [ -n "$diff" ] || changed=0
fi

if [ "$changed" = 1 ]; then
    stamp=$(date -u +%Y-%m-%d_%H%M%S)  # UTC: no duplicates or reordering at DST changes
    # Absolute --link-dest where possible: rrsync rejects ".." in option paths.
    link=()
    if [ -n "$latest" ]; then
        case $TARGET in
            /*) link=(--link-dest="$TARGET/$latest") ;;
            *)  link=(--link-dest="../$latest") ;;
        esac
    fi
    rsync_low "${OPTS[@]}" "${FILTER[@]}" "${link[@]}" \
        "${BACKUP_SOURCE%/}/" "$(remote_path "$TARGET/$stamp/")"
    printf '%s %s %s\n' "$(hostname)" "$BACKUP_SOURCE" "$(date -Is)" > "$EMPTY/$stamp.complete"
    rsync_low "$EMPTY/$stamp.complete" "$(remote_path "$TARGET/")"
    rm -f "$EMPTY/$stamp.complete"
    complete+=("$stamp")
    log "snapshot $stamp created${latest:+ (based on $latest)}"
fi

# Clean up: delete old complete snapshots and aborted ones
cutoff=$(date -u -d "-$BACKUP_KEEP_DAYS days" +%Y-%m-%d_%H%M%S)
n=${#complete[@]}
delete=()
for ((i = 0; i < n - BACKUP_KEEP_MIN; i++)); do
    [[ ${complete[i]} < $cutoff ]] && delete+=("${complete[i]}")
done
for d in "${dirs[@]}"; do
    printf '%s\n' "${complete[@]}" | grep -qx "$d" || delete+=("$d")
done
if [ "${#delete[@]}" -gt 0 ]; then
    del_filter=()
    for d in "${delete[@]}"; do
        del_filter+=(--include="/$d/***" --include="/$d.complete")
    done
    rsync_low -r --delete "${del_filter[@]}" --exclude='*' "$EMPTY/" "$(remote_path "$TARGET/")"
    log "deleted: ${delete[*]}"
fi
